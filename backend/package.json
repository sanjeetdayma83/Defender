{
    "name":  "loss-defender-backend",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "db:seed":  "tsx prisma/seed.ts",
                    "test:phase5-6":  "tsx scripts/phase5-6.integration.ts",
                    "db:migrate:deploy":  "prisma migrate deploy",
                    "db:migrate:status":  "prisma migrate status",
                    "db:generate":  "prisma generate"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1137.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1137.0",
                         "@prisma/adapter-pg":  "^7.10.0",
                         "@prisma/client":  "^7.10.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^17.2.2",
                         "express":  "^5.1.0",
                         "firebase-admin":  "^14.5.0",
                         "helmet":  "^8.1.0",
                         "multer":  "^2.4.0",
                         "pdfkit":  "^0.20.2",
                         "pg":  "^8.23.0",
                         "puppeteer":  "^25.12.0",
                         "razorpay":  "^2.9.8",
                         "xlsx":  "^0.18.5"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.3",
                            "@types/multer":  "^2.2.0",
                            "@types/node":  "^24.3.0",
                            "@types/pdfkit":  "^0.17.6",
                            "@types/pg":  "^8.23.1",
                            "prisma":  "^7.10.0",
                            "tsx":  "^4.20.5",
                            "typescript":  "^5.9.2"
                        }
}
