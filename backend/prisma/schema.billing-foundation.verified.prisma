enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  SCAN
  PACKING_STARTED
  EVIDENCE_UPLOADED
  WALLET_CONSUMED
  PACKING_COMPLETED
  ORDER_PACKED
  ERROR

  PLAN_CREATED
  PLAN_UPDATED
  PLAN_DEACTIVATED

  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_EXPIRED

  PAYMENT_CREATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED

  CREDIT_ALLOCATION
  EXTRA_SCAN_PURCHASE
  RETENTION_PURCHASE
}

// ============================================================
// LOSS DEFENDER - DATABASE SCHEMA
// PostgreSQL / Neon + Prisma 7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum Marketplace {
  FLIPKART
  AMAZON
  MEESHO
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatus {
  CREATED
  READY_TO_PACK
  PACKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PackingSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceStatus {
  PROCESSING
  READY
  FAILED
}

enum MediaType {
  VIDEO
  PHOTO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionProvider {
  MANUAL
  RAZORPAY
  STRIPE
  OTHER
}

enum ScanTransactionType {
  ALLOCATION
  CONSUMPTION
  TOPUP
  REFUND
  ADJUSTMENT
  EXPIRATION
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentItemType {
  PLAN
  EXTRA_SCAN_PACK
  RETENTION
  ADJUSTMENT
}

enum SubscriptionEntitlementUnit {
  COUNT
  DAYS
  BOOLEAN
}

// ============================================================
// COMPANY / USER / WAREHOUSE
// ============================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  CANCELLED
  REFUNDED
}

enum InvoiceItemType {
  PLAN
  EXTRA_SCAN_PACK
  RETENTION
  ADJUSTMENT
}

model Company {
  id       String  @id @default(cuid())
  name     String
  code     String? @unique
  isActive Boolean @default(true)

  users               User[]
  warehouses          Warehouse[]
  products            Product[]
  orders              Order[]
  marketplaceAccounts MarketplaceAccount[]
  auditLogs           AuditLog[]
  storageObjects      StorageObject[]
  storageUsageEvents  StorageUsageEvent[]
  billingProfile      BillingProfile?
  invoices            Invoice[]

  subscription Subscription?
  scanWallet   ScanWallet?
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("companies")
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String
  name        String?
  phone       String?
  designation String?
  role        UserRole @default(OPERATOR)
  isActive    Boolean  @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  packingSessions PackingSession[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  code     String
  address  String?
  city     String?
  state    String?
  country  String  @default("India")
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orders          Order[]
  packingSessions PackingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

// ============================================================
// MARKETPLACE
// ============================================================

model MarketplaceAccount {
  id          String      @id @default(cuid())
  marketplace Marketplace
  accountName String
  sellerId    String?
  isActive    Boolean     @default(true)

  // Store encrypted/secured references only.
  // Raw marketplace secrets should NOT be stored here.
  credentialRef String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, marketplace, accountName])
  @@index([companyId, marketplace])
  @@map("marketplace_accounts")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String  @id @default(cuid())
  sku         String
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  variants       ProductVariant[]
  orderItems     OrderItem[]
  barcodeAliases BarcodeAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([sku])
  @@map("products")
}

model ProductVariant {
  id          String  @id @default(cuid())
  sku         String
  name        String?
  variantName String?
  color       String?
  size        String?
  imageUrl    String?
  quantity    Int     @default(0)
  isActive    Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems     OrderItem[]
  barcodeAliases BarcodeAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([sku])
  @@map("product_variants")
}

model BarcodeAlias {
  id       String  @id @default(cuid())
  barcode  String
  type     String
  isActive Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barcode])
  @@index([productId])
  @@index([variantId])
  @@map("barcode_aliases")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id String @id @default(cuid())

  externalOrderId    String
  marketplaceOrderId String?
  marketplace        Marketplace

  status OrderStatus @default(PENDING)

  customerName    String?
  customerPhone   String?
  shippingAddress String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  marketplaceAccountId String?
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  shipments       Shipment[]
  packingSessions PackingSession[]
  auditLogs       AuditLog[]

  orderedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, marketplace, externalOrderId])
  @@index([companyId, status])
  @@index([warehouseId, status])
  @@index([marketplace, externalOrderId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  quantity  Int
  unitPrice Decimal? @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// SHIPMENTS
// ============================================================

model Shipment {
  id String @id @default(cuid())

  awb         String
  carrier     String?
  trackingUrl String?
  status      ShipmentStatus @default(CREATED)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  packingSessions PackingSession[]
  auditLogs       AuditLog[]
  barcodeAliases  ShipmentBarcode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([awb])
  @@index([orderId])
  @@index([awb])
  @@map("shipments")
}

model ShipmentBarcode {
  id       String  @id @default(cuid())
  barcode  String
  type     String
  isActive Boolean @default(true)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([barcode])
  @@index([shipmentId])
  @@map("shipment_barcodes")
}

// ============================================================
// PACKING / EVIDENCE
// ============================================================

model PackingSession {
  id     String               @id @default(cuid())
  status PackingSessionStatus @default(ACTIVE)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  media     EvidenceMedia[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([shipmentId])
  @@index([userId])
  @@index([status])
  @@map("packing_sessions")
}

model EvidenceMedia {
  id     String         @id @default(cuid())
  type   MediaType
  status EvidenceStatus @default(PROCESSING)

  fileName        String
  storageKey      String
  contentType     String?
  sizeBytes       BigInt?
  durationSeconds Float?

  packingSessionId String
  packingSession   PackingSession @relation(fields: [packingSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packingSessionId])
  @@index([type])
  @@index([status])
  @@map("evidence_media")
}

// ============================================================
// PLANS / SUBSCRIPTIONS
// ============================================================

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  monthlyPrice Decimal? @db.Decimal(12, 2)
  yearlyPrice  Decimal? @db.Decimal(12, 2)

  monthlyScanCredits Int @default(0)
  maxWarehouses      Int @default(1)
  maxOperators       Int @default(1)
  maxOrdersPerMonth  Int @default(0)

  // Billing configuration
  pricePaise          Int?
  gstPercent          Int  @default(18)
  validityMonths      Int?
  includedScans       Int  @default(0)
  normalRetentionDays Int  @default(30)
  sortOrder           Int  @default(0)

  isActive Boolean @default(true)

  subscriptions Subscription[]
  features      PlanFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status          SubscriptionStatus   @default(TRIALING)
  billingInterval BillingInterval      @default(MONTHLY)
  provider        SubscriptionProvider @default(MANUAL)

  providerCustomerId     String?
  providerSubscriptionId String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  cancelledAt        DateTime?

  entitlements SubscriptionEntitlement[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

model PlanFeature {
  id String @id @default(cuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  featureCode String
  enabled     Boolean @default(true)

  quantity Int?
  unit     String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureCode])
  @@index([planId])
  @@index([featureCode])
  @@map("plan_features")
}

model SubscriptionEntitlement {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  code         String
  name         String
  valueInt     Int?
  valueDecimal Decimal?                    @db.Decimal(12, 4)
  unit         SubscriptionEntitlementUnit @default(COUNT)
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, code])
  @@index([subscriptionId])
  @@map("subscription_entitlements")
}

model ExtraScanPack {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  scanCredits Int

  pricePaise Int
  gstPercent Int @default(18)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("extra_scan_packs")
}

model RetentionOption {
  id String @id @default(cuid())

  code String @unique
  name String

  retentionDays Int

  pricePaisePerScan Int
  gstPercent        Int @default(18)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([retentionDays])
  @@index([isActive])
  @@index([sortOrder])
  @@map("retention_options")
}

model BillingWebhookEvent {
  id            String               @id @default(cuid())
  provider      SubscriptionProvider
  eventId       String
  eventType     String
  payload       Json
  processed     Boolean              @default(false)
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([processed])
  @@map("billing_webhook_events")
}

model Payment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider          SubscriptionProvider @default(MANUAL)
  providerPaymentId String?
  providerOrderId   String?
  providerSignature String?

  status PaymentStatus @default(PENDING)

  currency      String @default("INR")
  subtotalPaise Int
  gstPaise      Int    @default(0)
  totalPaise    Int

  paidAt        DateTime?
  failureReason String?
  metadata      Json?

  items    PaymentItem[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([companyId, createdAt])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model PaymentItem {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  itemType    PaymentItemType
  referenceId String?
  code        String
  name        String

  quantity Int @default(1)

  unitPricePaise Int
  gstPaise       Int @default(0)
  totalPaise     Int

  metadata Json?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([itemType])
  @@map("payment_items")
}

// ============================================================
// SCAN WALLET
// ============================================================

model ScanWallet {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  balance           Int @default(0)
  lifetimeAllocated Int @default(0)
  lifetimeConsumed  Int @default(0)

  transactions ScanTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
  @@map("scan_wallets")
}

model ScanTransaction {
  id String @id @default(cuid())

  walletId String
  wallet   ScanWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  companyId String
  type      ScanTransactionType

  credits      Int
  balanceAfter Int

  referenceType String?
  referenceId   String?

  idempotencyKey String? @unique
  description    String?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([companyId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("scan_transactions")
}

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  packingSessionId String?
  packingSession   PackingSession? @relation(fields: [packingSessionId], references: [id], onDelete: SetNull)

  referenceType String?
  referenceId   String?

  awb         String?
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@index([shipmentId, createdAt])
  @@index([packingSessionId, createdAt])
  @@index([action, createdAt])
  @@index([referenceType, referenceId])
  @@map("audit_logs")
}

enum StorageObjectType {
  EVIDENCE
  INVOICE
  CREDIT_NOTE
  EXPORT
  OTHER
}

enum StorageUsageEventType {
  UPLOAD
  DELETE
  RETENTION_DELETE
  RECONCILIATION
  ADJUSTMENT
}

model StorageObject {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  objectType StorageObjectType @default(OTHER)

  bucket     String
  storageKey String

  contentType String?
  sizeBytes   BigInt  @default(0)

  originalFileName String?

  checksum String?

  referenceType String?
  referenceId   String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  storageUsageEvents StorageUsageEvent[]
  invoices           Invoice[]

  @@index([companyId, objectType])
  @@index([companyId, createdAt])
  @@index([storageKey])
  @@index([referenceType, referenceId])
  @@map("storage_objects")
}

model StorageUsageEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  storageObjectId String?
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  eventType StorageUsageEventType

  sizeBytes BigInt

  reason String?

  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, eventType])
  @@index([storageObjectId])
  @@map("storage_usage_events")
}

model BillingProfile {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  legalName   String
  displayName String?

  gstin String?
  pan   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?
  postalCode   String?
  country      String  @default("India")

  billingEmail String?
  billingPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gstin])
  @@map("billing_profiles")
}

model Invoice {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  invoiceNumber String @unique

  status InvoiceStatus @default(DRAFT)

  currency String @default("INR")

  customerLegalName   String
  customerDisplayName String?

  customerGstin String?
  customerPan   String?

  customerAddressLine1 String?
  customerAddressLine2 String?
  customerCity         String?
  customerState        String?
  customerStateCode    String?
  customerPostalCode   String?
  customerCountry      String  @default("India")

  customerBillingEmail String?
  customerBillingPhone String?

  placeOfSupplyState     String?
  placeOfSupplyStateCode String?

  subtotalPaise Int
  gstPaise      Int @default(0)
  totalPaise    Int

  issuedAt DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  pdfStorageObjectId String?
  pdfStorageObject   StorageObject? @relation(fields: [pdfStorageObjectId], references: [id], onDelete: SetNull)

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([paymentId])
  @@index([pdfStorageObjectId])
  @@map("invoices")
}

model InvoiceSequence {
  id        String   @id @default(cuid())
  year      Int      @unique
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemType InvoiceItemType

  description String

  quantity Int @default(1)

  unitPricePaise     Int
  taxableAmountPaise Int

  gstPercent Int @default(18)
  gstPaise   Int @default(0)

  totalPaise Int

  referenceType String?
  referenceId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([referenceType, referenceId])
  @@map("invoice_items")
}
