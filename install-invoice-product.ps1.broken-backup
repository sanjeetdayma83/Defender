$ErrorActionPreference = "Stop"
$Repo = "D:\Loss Defender"
$Backend = Join-Path $Repo "backend"
if (-not (Test-Path $Backend)) { throw "Backend not found: $Backend" }
Set-Location $Backend

Write-Host "=== LOSS DEFENDER — INVOICE TEMPLATE IMPLEMENTATION ===" -ForegroundColor Cyan

# Safety backups — never overwrite existing source silently.
$stamp = Get-Date -Format "yyyyMMdd-HHmmss"
$backup = Join-Path $Backend ".invoice-prechange-$stamp"
New-Item -ItemType Directory -Force -Path $backup | Out-Null
foreach ($p in @("prisma\schema.prisma","src\app.ts")) {
  if (Test-Path $p) { Copy-Item $p (Join-Path $backup ([IO.Path]::GetFileName($p))) }
}
Write-Host "Backup: $backup" -ForegroundColor DarkGray

Write-Host "[1/7] Installing Puppeteer..." -ForegroundColor Yellow
npm install puppeteer

function Write-B64File($RelativePath, $B64) {
  $full = Join-Path $Backend $RelativePath
  $dir = Split-Path $full -Parent
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  [IO.File]::WriteAllBytes($full, [Convert]::FromBase64String($B64))
}

Write-Host "[2/7] Installing exact invoice HTML template..." -ForegroundColor Yellow
Write-B64File "src\services\invoice\templates\loss-defender-pro-invoice.html" ""

Write-Host "[3/7] Installing PDF invoice service..." -ForegroundColor Yellow
Write-B64File "src\services\invoice\invoice.service.ts" ""
Write-B64File "src\controllers\invoice\invoice.controller.ts" ""
Write-B64File "src\routes\invoice.routes.ts" ""

Write-Host "[4/7] Adding Invoice Prisma models if missing..." -ForegroundColor Yellow
$schemaPath = Join-Path $Backend "prisma\schema.prisma"
$schema = Get-Content $schemaPath -Raw
if ($schema -notmatch '(?m)^model Invoice \{') {
  Add-Content -Path $schemaPath -Value "`_PLACEHOLDER"
  $raw = Get-Content $schemaPath -Raw
  $raw = $raw -replace '_PLACEHOLDER', ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("")))
  Set-Content -Path $schemaPath -Value $raw -Encoding UTF8
  Write-Host "Invoice + InvoiceItem models added." -ForegroundColor Green
} else {
  Write-Host "Invoice model already exists; leaving it unchanged." -ForegroundColor DarkYellow
}

Write-Host "[5/7] Prisma format + migration + generate..." -ForegroundColor Yellow
npx prisma format
npx prisma migrate dev --name add_invoices_and_invoice_items
npx prisma generate

Write-Host "[6/7] Registering invoice route if not already registered..." -ForegroundColor Yellow
$appPath = Join-Path $Backend "src\app.ts"
$app = Get-Content $appPath -Raw
if ($app -notmatch 'invoice\.routes\.js') {
  if ($app -notmatch 'import invoiceRoutes from "\./routes/invoice\.routes\.js";') {
    $app = $app -replace '(?m)^import warehouseRoutes from "\./routes/warehouse\.routes\.js";\r?\n', '$0import invoiceRoutes from "./routes/invoice.routes.js";`r`n'
  }
  $anchor = 'app.use("/api/v1/warehouses", firebaseAuthMiddleware, warehouseRoutes);'
  if ($app.Contains($anchor)) {
    $app = $app.Replace($anchor, $anchor + "`r`napp.use(\"/api/v1/invoices\", firebaseAuthMiddleware, invoiceRoutes);")
    Set-Content -Path $appPath -Value $app -Encoding UTF8
    Write-Host "Invoice route registered at /api/v1/invoices" -ForegroundColor Green
  } else {
    Write-Host "Could not find warehouse route anchor; add invoice route manually." -ForegroundColor DarkYellow
  }
} else {
  Write-Host "Invoice route already registered; leaving app.ts unchanged." -ForegroundColor DarkYellow
}

Write-Host "[7/7] Building backend..." -ForegroundColor Yellow
npm run build
Write-Host "`nInvoice template implementation installed successfully." -ForegroundColor Green
Write-Host "Test endpoint: GET /api/v1/invoices/payments/:paymentId/pdf" -ForegroundColor Cyan
Write-Host "Important: this first implementation renders invoices from SUCCESS payments; billing-profile GST/address fields remain to be connected before live tax invoices." -ForegroundColor Yellow
